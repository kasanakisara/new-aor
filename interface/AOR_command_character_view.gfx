spriteTypes = {
	# 顾问窗口顶部分类条底板：按实际显示尺寸 501x58 出的整图（原为 tiled_plain_bg_lined
	# 以 8px 边角拉伸），改图直接改这张，不影响其它共用 lined 的界面。
	# 金线：上 y 4~5、下 y 52~53、左 x 4~5、右 x 495~496，改图时保持这几条线的位置，
	# 才能继续贴住标题红条和下方列表黄线。
	spriteType = {
		name = "GFX_AOR_command_character_header_bg"
		textureFile = "gfx/interface/AOR_cabinet_header_bar.dds"
	}

	# 顾问窗口分类按钮图标：第 N 格 = 特质 sprite = N 的分类（ADVISOR_CATEGORY_N）。
	# 1~18 同原版 idea_traits_strip；19~23 为政治顾问身份分类，24~32 空着备用：
	# 19 理论家 20 工会负责人 21 政府成员 22 实业家 23 经济学家
	# 引擎每人只算一个分类（取特质列表里第一个带编号的特质），所以只按身份分类，
	# 党派特质不带编号。成长型内阁（自定义栏位）引擎不生成分类按钮，不给它的特质编号。
	# 人物卡、内阁栏位仍用 GFX_idea_traits_strip，其 19~32 格是透明的，不在头像上叠图标。
	spriteType = {
		name = "GFX_AOR_advisor_category_strip"
		texturefile = "gfx/interface/ideas/AOR_advisor_category_strip.dds"
		noOfFrames = 32
	}
}
