# Newspaper: 480 x 720; 4 columns x 25 rows. Each visible row is 1 percentage point.
# Row order: down each column, then left to right. Three mutually exclusive icons per row.
guiTypes = {
	containerWindowType = {
		name = "GER_SPD_newspaper_window"
		# Move the entire newspaper here: +x right, +y down (pixels relative to the category).
		position = { x = 20 y = 0 }
		size = { width = 500 height = 730 }
		clipping = yes
		# Silent backing consumes clicks before they reach the decision category background.
		iconType = {
			name = "GER_SPD_paper"
			position = { x = 10 y = 4 }
			spriteType = "GFX_GER_SPD_newspaper_background"
	
		}
		# Paper starts at (10,4), size 480x720; 31x31 icon inset 2px from top/right.
