guiTypes = {
	containerWindowType = {
		name = "command_character_view_window"
		position = { x = 540 y = 80 }
		fade_time = 5000
		fade_type = accelerated
		size = { width=500 height=590 }
		show_sound = open_sub_window

		background = {
			name = "Background"
			quadTextureSprite = "GFX_category_header"
			position = { x = -15 y = 7 }
			size = { x = 500 y = 44 }
		}

		instantTextboxType = {
			name = "title"
			position = { x = -117 y = 19 }
			font = "hoi_20b"
			text = "Characters Place Holder"
			maxWidth = 450
			maxHeight = 20
			format = center
		}

		# 1.19 的 command_character_view 代码会去取名为 switch 的元素；本文件是在
		# 旧版原版基础上改的，整块漏掉了它，导致 containerwindow.cpp 报
		# 'Could not find "switch" in window command_character_view_window'。
		# 现按 1.19 原版补回（y 由 26 调为 30，避免与下方 ideas 容器重叠）。
		instantTextboxType = {
			name = "switch"
			position = { x = 0 y = 30 }
			font = "hoi_18b"
			text = "Switch out Character Place Holder"
			maxWidth = 450
			maxHeight = 20
			format = center
		}

		containerWindowType = {
			name = "ideas"
			position = { x = 0 y = 42 }
			size = { width=500 height=542 }
			clipping = yes
			
			containerWindowType = {
				name = "grid"
				position = { x = 0 y = 0 }
				size = { width=500 height=100%% }
				clipping = yes
				verticalScrollbar = "right_vertical_slider"
				scroll_wheel_factor = 37
				smooth_scrolling = yes
				margin = { top = 15 bottom = 12 }
				
				background = {
					name = "Background"
					quadTextureSprite ="GFX_tiled_window2_1b_border"
					position = { x = -1 y = 3 }
				}

				# Hide the cabinet's ornamental overlay; keep the list border.

				gridBoxType = {
					name = "box_grid"
					position = { x = 10 y = 3 }
					size = { width = 100%% height = 1 }
					slotsize = { width = 231 height = 96 }
					max_slots_horizontal = 2
					add_horizontal = yes
					format = "UPPER_LEFT"
				}
			}
		}

		# Keep the game's filter-grid binding without showing the old header strip.
		containerWindowType = {
			name = "header"
			position = { x = -2000 y = 43 }
			size = { width=500 height=50 }
			containerWindowType = {
				name = "filters"
				position = { x = 0 y = 0 }
				size = { width=48% height=100% }
				gridBoxType = {
					name = "filter_grid"
					position = { x = 10 y = 10 }
					size = { width = 100% height = 100% }
					slotsize = { width = 70 height = 50 }
					max_slots_horizontal = 6
					add_horizontal = yes
					format = "UPPER_LEFT"
				}
			}
		}

		buttonType = {
			name = "close"
			position = { x = -50 y = 9 }
			quadTextureSprite ="GFX_closebutton"
			buttonFont = "Main_14_black"
			Orientation = "UPPER_RIGHT"
			clicksound = click_close
			pdx_tooltip = "CLOSE"
		}

		buttonType = {
